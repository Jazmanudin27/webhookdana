# Konfigurasi Server
PORT=3000
NODE_ENV=development

# Domain Public / Webhook Endpoint URL
# Domain tunnel / live Anda: https://dana.aspartech.com
PUBLIC_BASE_URL=https://dana.aspartech.com

# Konfigurasi DANA Sandbox API (Optional untuk Signature Verification / Direct API)
DANA_CLIENT_ID=2021000000000001
DANA_CLIENT_SECRET=sandbox_secret_key_example
DANA_MERCHANT_ID=216610000000000000001
DANA_ENVIRONMENT=SANDBOX

# Konfigurasi ESP32 & Depot
DEFAULT_FLOW_PULSE_PER_LITER=450
PRICE_1_GALON=7000
LITER_1_GALON=19
PRICE_2_GALON=14000
LITER_2_GALON=38
